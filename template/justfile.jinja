# {{ project_name }}
# Run `just --list` to see available recipes

# Quiet by default to save context; use verbose=true for full output
verbose := "false"

# Default recipe - show available commands
default:
    @just --list

# === Setup ===

# Install pre-commit hooks and verify dependencies
setup:
    pre-commit install
    @echo "Setup complete."

# === Quality ===

# Run all quality checks (pre-push gate)
check:
    pre-commit run --all-files
{% if language == 'go' %}
# === Go ===

# Build the binary
build:
    go build {% if verbose == "false" %}-v{% endif %} ./...

# Run tests
test *args="./...":
    go test {% if verbose == "true" %}-v{% endif %} {{ '{{' }}args{{ '}}' }}

# Run linter
lint:
    golangci-lint run ./...

# Format code
fmt:
    gofmt -w .
{% endif %}
{% if language == 'python' %}
# === Python ===

# Install in development mode
install:
    pip install -e ".[dev]"

# Run tests
test *args="":
    pytest {{ '{{' }}args{{ '}}' }}

# Run linter
lint:
    ruff check .

# Format code
fmt:
    ruff format .
{% endif %}
{% if language == 'rust' %}
# === Rust ===

# Build the project
build:
    cargo build

# Run tests
test *args="":
    cargo test {{ '{{' }}args{{ '}}' }}

# Run linter
lint:
    cargo clippy -- -D warnings

# Format code
fmt:
    cargo fmt
{% endif %}
{% if include_mdbook %}
# === Documentation ===

# Documentation management: just docs <cmd>
# Commands: build, serve{% if include_markdown_linting %}, lint, fix, fmt, vale, check{% endif %}

docs cmd="build":
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{ '{{' }}cmd{{ '}}' }}" in
        build)    mdbook build docs/book ;;
        serve)    mdbook serve docs/book --open ;;
{%- if include_markdown_linting %}
        lint)     npx markdownlint-cli2 "docs/book/src/**/*.md" "README.md" "CONTRIBUTING.md" ;;
        fix)      npx markdownlint-cli2 --fix "docs/book/src/**/*.md" "README.md" "CONTRIBUTING.md" ;;
        fmt)      npx prettier --write "docs/book/src/**/*.md" --prose-wrap preserve ;;
        vale)     vale docs/book/src/ ;;
        check)    just docs lint && just docs build ;;
{%- endif %}
        *)        echo "Unknown: {{ '{{' }}cmd{{ '}}' }}. Try: build serve{% if include_markdown_linting %} lint fix fmt vale check{% endif %}" ;;
    esac
{% endif %}
