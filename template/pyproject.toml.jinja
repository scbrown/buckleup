[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_description }}"
authors = [{ name = "{{ author_name }}" }]
requires-python = ">=3.11"
license = "{{ license }}"

[tool.pytest.ini_options]
testpaths = ["tests"]
